{
  "expo": {
    "name": "UpBazaar",
    "owner": "upbazaar-apk",
    "slug": "upbazaar-apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",

    "android": {
      "package": "com.indravasagroup.upbazaar",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [],
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      "./plugins/withKotlinVersion",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow UpBazaar to use your location."
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "39d4ce46-57d5-4698-9d34-1db3c78860e2"
      }
    },

    "sdkVersion": "52.0.0"
  }
}
