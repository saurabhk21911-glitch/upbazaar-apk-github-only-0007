{
  "expo": {
    "name": "upbazaar",
    "slug": "upbazaar-trending",
    "owner": "indra_telecom_0007s_team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.indravasgroup.upbazaar",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      "./plugins/withKotlinVersion",
      "expo-location",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_CURRENT_PROJECT_ID"
      }
    },
    "sdkVersion": "52.0.0",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
